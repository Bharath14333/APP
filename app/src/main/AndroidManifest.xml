<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.emergency.crisissense">

    <!-- Permissions required for emergency alert system -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.CrisisSense"
        tools:targetApi="31">

        <!-- Launcher Screen -->
        <activity
            android:name=".activity.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.CrisisSense.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Screens -->
        <activity android:name=".activity.IntroActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.WelcomeActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.LoginActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.RegisterActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.ForgotPasswordActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.OtpVerificationActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />

        <!-- User/Dashboard Screens -->
        <activity android:name=".activity.MainActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.ReportEmergencyActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.UploadEvidenceActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.IncidentDetailsActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.IncidentHistoryActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.LiveAlertsActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.EmergencyContactsActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.NearbyServicesActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.MapActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.SosActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.VolunteerRegistrationActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        
        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="dummy_maps_api_key_placeholder" />
        <activity android:name=".activity.NotificationsActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.EditProfileActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.SettingsActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.HelpSupportActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.AboutActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />

        <!-- Admin Screens -->
        <activity android:name=".activity.AdminLoginActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.AdminDashboardActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.AdminUserManagementActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.AdminIncidentManagementActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.AdminAnalyticsActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />
        <activity android:name=".activity.AdminSystemLogsActivity" android:exported="false" android:theme="@style/Theme.CrisisSense.NoActionBar" />

        <!-- File Provider for Evidence Capture -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.emergency.crisissense.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Firebase Messaging Service -->
        <service
            android:name=".util.NotificationHelper$MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
