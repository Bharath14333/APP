<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Map Fragment container -->
    <fragment
        android:id="@+id/map_fragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Overlay: Back & Title -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#99000000"
        android:layout_alignParentTop="true">

        <ImageButton
            android:id="@+id/btn_map_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/white"
            android:contentDescription="Go Back"/>

        <TextView
            android:id="@+id/txt_map_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Assistance Map Directory"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Filters Scroll Bar Overlay -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/top_bar"
        android:padding="8dp"
        android:scrollbars="none"
        android:background="#44000000">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="All"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TonalButton" />

            <Button
                android:id="@+id/btn_filter_hospitals"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="🏥 Hospitals"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TonalButton" />

            <Button
                android:id="@+id/btn_filter_police"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="🚔 Police"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TonalButton" />

            <Button
                android:id="@+id/btn_filter_fire"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="🚒 Fire"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TonalButton" />

            <Button
                android:id="@+id/btn_filter_pharmacies"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="💊 Pharmacy"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TonalButton" />

            <Button
                android:id="@+id/btn_filter_shelters"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🛟 Shelters"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TonalButton" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Recenter FAB Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_recenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_above="@+id/layout_marker_details"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_mylocation"
        app:backgroundTint="@color/primary"
        android:tint="@color/white"
        android:contentDescription="Recenter Map" />

    <!-- Details Card Container (Simulated bottom sheet) -->
    <FrameLayout
        android:id="@+id/layout_marker_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:padding="16dp"
        android:visibility="gone">

        <!-- Inflate bottom_sheet_service_details.xml here inside card -->
        <include layout="@layout/bottom_sheet_service_details" />
    </FrameLayout>

</RelativeLayout>
